# Release-table OUTPUTS are products: never commit them. Every script writes to a path given on
# the command line; these rules catch anything written here by accident.
*.h5
*.hdf5
*.fits
*.fits.gz
*.npy
*.npz
*.parquet
*.jls
*.csv
*.csv.gz
*.log
*.tmp
*.tmp-*
